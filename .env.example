# MongoDB connection (use service name 'mongodb' when running in Docker)
MONGODB_URI=mongodb://mongodb:27017/urban-kit

# Payload CMS secret — must be at least 32 characters
PAYLOAD_SECRET=change-this-to-a-random-secret-min-32-chars

# Public server URL (used by Payload for media URLs etc.)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# SMTP / email (Nodemailer adapter). If SMTP_HOST is empty, Payload falls back
# to an ethereal.email mock in dev and logs a preview URL instead of sending.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Default envelope sender — must be allowed by your SMTP provider
SMTP_FROM_ADDRESS=noreply@urban-kit.local
SMTP_FROM_NAME=Urban Kit

# Method assistant (chatbot). Server-side only — keys are never exposed to the
# browser. The widget is disabled (site falls back to manual filtering) unless the
# selected provider's API key is set.
#
# Pick a provider (default: anthropic) and, optionally, a model id for it.
#   METHOD_ASSISTANT_PROVIDER = anthropic | openai | mistral
#   METHOD_ASSISTANT_MODEL    = model id (optional; sensible default per provider)
METHOD_ASSISTANT_PROVIDER=mistral
METHOD_ASSISTANT_MODEL=mistral-small-latest

# Set the key for whichever provider you selected above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Global cost ceiling: assistant requests per day across ALL visitors (default
# 600). Once reached, the assistant reports itself unavailable until midnight
# UTC and the site falls back to manual filtering. The per-IP limit (requests
# per 5 minutes) is configured in the Assistant global in the admin.
ASSISTANT_DAILY_MAX=600

NODE_ENV=production

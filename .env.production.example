# =============================================================================
# PRODUCTION env — copy to `.env` on the VPS and fill in real values.
#   cp .env.production.example .env   # then edit
# Never commit the filled-in .env (it's gitignored).
# =============================================================================

# --- MongoDB ---------------------------------------------------------------
# Root credentials for the mongo container (used by docker-compose.prod.yml).
# MONGO_ROOT_PASSWORD: generate with `openssl rand -base64 32`
MONGO_ROOT_USER=urbankit
MONGO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl

# Connection string MUST embed the same credentials and authSource=admin.
# Host is the compose service name `mongodb`.
MONGODB_URI=mongodb://urbankit:CHANGE_ME_generate_with_openssl@mongodb:27017/urban-kit?authSource=admin

# --- Payload ---------------------------------------------------------------
# Signs auth tokens. Generate with: `openssl rand -base64 48`  (min 32 chars)
PAYLOAD_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Your real public URL (used for media URLs, emails, etc.). Use https://
NEXT_PUBLIC_SERVER_URL=https://your-domain.example

NODE_ENV=production

# --- SMTP / email ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@your-domain.example
SMTP_FROM_NAME=Urban Kit

# --- Method assistant (chatbot) -------------------------------------------
# Widget stays disabled unless the selected provider's key is set.
METHOD_ASSISTANT_PROVIDER=anthropic
METHOD_ASSISTANT_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

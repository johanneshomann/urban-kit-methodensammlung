{
  "name": "urban-kit-methodensammlung",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3040",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:schema": "cross-env NODE_OPTIONS=--no-deprecation payload-graphql generate:schema",
    "seed": "npx tsx seed.ts",
    "migrate:localization": "npx tsx scripts/migrate-localization.ts",
    "backfill:similar": "npx tsx scripts/backfill-similar-methods.ts",
    "migrate:media-alt": "npx tsx scripts/migrate-media-alt-localized.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.86",
    "@ai-sdk/mistral": "^3.0.40",
    "@ai-sdk/openai": "^3.0.74",
    "@payloadcms/db-mongodb": "3.84.1",
    "@payloadcms/email-nodemailer": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/translations": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@react-pdf/renderer": "^4.5.1",
    "@swc/helpers": "^0.5.21",
    "ai": "^6.0.209",
    "cross-env": "^7.0.3",
    "graphql": "16.8.1",
    "lucide-react": "^1.17.0",
    "next": "^15.4.11",
    "next-intl": "^4.12.0",
    "nodemailer": "^9.0.1",
    "payload": "3.84.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "22.15.18",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.3",
    "dotenv": "^16.5.0",
    "postcss": "8.5.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
